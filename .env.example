# ==========================================
# AI-Powered Document Intelligence System
# Configuration
# ==========================================

# --- LLM Providers (set at least one key for live extraction) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# auto | openai | gemini
LLM_PROVIDER=auto
# Order used by "auto" when both keys exist
LLM_PREFERENCE=openai,gemini
# If true and both keys exist, retry a failed extraction on the other provider
LLM_FALLBACK_ENABLED=true

OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Embeddings (semantic search) ---
# auto = follow whichever provider has a key
EMBEDDING_PROVIDER=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- OCR / Processing ---
OCR_LANGS=eng
OCR_DPI=250
PDF_MIN_TEXT_CHARS_PER_PAGE=50
USE_LLM_VISION_FALLBACK=false

# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/docintel
REDIS_URL=redis://redis:6379/0
JWT_SECRET=super-secret-docintel-key-change-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- File Storage & Limits ---
MAX_UPLOAD_MB=100
UPLOAD_DIR=/data/uploads

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
