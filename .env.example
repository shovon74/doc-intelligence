# ==========================================
# AI-Powered Document Intelligence System
# Configuration
# ==========================================

# --- LLM (Gemini is the default; GEMINI_API_KEY is all you need) ---
GEMINI_API_KEY=
# Optional: only used if you switch LLM_PROVIDER to openai
OPENAI_API_KEY=

# gemini (default) | openai | auto (auto = first configured key, with fallback to the other)
LLM_PROVIDER=gemini
# Order used only when LLM_PROVIDER=auto
LLM_PREFERENCE=gemini,openai
# Only applies when LLM_PROVIDER=auto and both keys exist
LLM_FALLBACK_ENABLED=true

OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Embeddings (semantic search) ---
# Keep this fixed: all vectors in the index must come from the same model.
# If you change it, reprocess every document.
EMBEDDING_PROVIDER=gemini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- OCR / Processing ---
OCR_LANGS=eng
OCR_DPI=250
PDF_MIN_TEXT_CHARS_PER_PAGE=50
USE_LLM_VISION_FALLBACK=false

# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/docintel
REDIS_URL=redis://redis:6379/0
JWT_SECRET=super-secret-docintel-key-change-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- File Storage & Limits ---
MAX_UPLOAD_MB=100
UPLOAD_DIR=/data/uploads

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
